{
  "$comment": "Selection policy of the full Entry Point (make check). Read by scripts/run-mode.mjs. Changing this file widens validation by change to every check.",
  "version": 1,
  "budgetSeconds": 2400,
  "base": "main",
  "dependencyRoots": ["src", "test", "features"],
  "sharedConfiguration": [
    "package.json",
    "package-lock.json",
    ".gitignore",
    ".githooks/**",
    "mise.toml",
    "Makefile",
    "tsconfig.json",
    "tsconfig.build.json",
    "eslint.config.mjs",
    "eslint.metrics.config.mjs",
    ".prettierrc.json",
    ".prettierignore",
    ".dependency-cruiser.*.cjs",
    ".jscpd.json",
    ".gitleaks.toml",
    "stryker.config.mjs",
    "vitest.config.ts",
    "vitest.mutation.config.ts",
    "cucumber.mjs",
    "harness/**",
    "scripts/**",
    "test/support/**",
    "features/support/**"
  ],
  "checks": [
    {
      "id": "format",
      "gate": "Format",
      "tier": "fast",
      "appliesTo": ["**"],
      "scope": "affected",
      "cadence": "change",
      "costSeconds": 5
    },
    {
      "id": "lint",
      "gate": "Lint",
      "tier": "fast",
      "appliesTo": ["**/*.ts", "**/*.mjs", "**/*.cjs"],
      "scope": "affected",
      "cadence": "change",
      "costSeconds": 30
    },
    {
      "id": "types",
      "gate": "Types",
      "tier": "fast",
      "appliesTo": ["**/*.ts"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 10
    },
    {
      "id": "unit",
      "gate": "Unit tests",
      "tier": "fast",
      "appliesTo": ["src/**/*.ts"],
      "scope": "affected",
      "cadence": "change",
      "costSeconds": 5
    },
    {
      "id": "boundaries",
      "gate": "Context boundaries",
      "tier": "fast",
      "appliesTo": ["src/**"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 3
    },
    {
      "id": "dependency-rule",
      "gate": "Dependency rule",
      "tier": "fast",
      "appliesTo": ["src/**"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 3
    },
    {
      "id": "metrics",
      "gate": "Static metrics",
      "tier": "fast",
      "appliesTo": ["src/**"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 10
    },
    {
      "id": "secrets",
      "gate": "Secrets",
      "tier": "fast",
      "appliesTo": ["**"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 5
    },
    {
      "id": "avoided-terms",
      "gate": "Avoided terms",
      "tier": "fast",
      "appliesTo": ["src/**", "test/**", "features/**", "GLOSSARY.md"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 3
    },
    {
      "id": "guide-pointers",
      "gate": "Guide pointers",
      "tier": "fast",
      "appliesTo": ["**"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 2
    },
    {
      "id": "harness",
      "gate": "Harness tests",
      "tier": "full",
      "appliesTo": ["scripts/**", "harness/**", "test/harness/**"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 20
    },
    {
      "id": "integration",
      "gate": "Integration tests",
      "tier": "full",
      "appliesTo": ["src/**/*.ts"],
      "scope": "affected",
      "cadence": "change",
      "costSeconds": 60
    },
    {
      "id": "e2e",
      "gate": "E2E tests",
      "tier": "full",
      "appliesTo": ["src/**/*.ts", "features/**"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 90
    },
    {
      "id": "vulnerabilities",
      "gate": "Dependency vulnerabilities",
      "tier": "full",
      "appliesTo": ["**"],
      "scope": "whole",
      "cadence": "change",
      "costSeconds": 10
    },
    {
      "id": "mutation",
      "gate": "Mutation",
      "tier": "full",
      "appliesTo": ["src/**/*.ts"],
      "scope": "changed",
      "cadence": "change",
      "costSeconds": 600,
      "integral": "covered by mutation-whole, which mutates every file this check could"
    },
    {
      "id": "mutation-whole",
      "gate": "Mutation",
      "tier": "full",
      "appliesTo": ["src/**/*.ts"],
      "scope": "whole",
      "cadence": "periodic",
      "schedule": "weekly, Monday 03:00 UTC (.github/workflows/integral.yml), and on demand",
      "protectionBetweenRuns": "validation by change mutates every production file a change touches, at the same thresholds",
      "residualRisk": "a weakened test can let a mutant survive in production code the change did not touch; the weekly run bounds how long that stays unseen",
      "costSeconds": 900
    }
  ]
}
