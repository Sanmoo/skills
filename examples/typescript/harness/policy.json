{
  "version": 1,
  "baseBranch": "main",
  "budgetSeconds": 2400,
  "sourceTrees": ["src", "features", "test", "scripts"],
  "sharedPaths": [
    "package.json",
    "package-lock.json",
    "harness/**",
    "Makefile",
    "mise.toml",
    "tsconfig*.json",
    "eslint*.mjs",
    "stryker.config.mjs",
    "cucumber.mjs",
    "vitest*.ts",
    ".gitleaks.toml",
    ".jscpd.json",
    ".dependency-cruiser*",
    ".prettierrc*",
    ".prettierignore",
    ".gitignore",
    ".editorconfig",
    "*.config.mjs",
    "*.config.ts",
    "*.config.js",
    "*.config.cjs",
    ".github/**"
  ],
  "checks": [
    {
      "gate": "Format",
      "target": "format",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 5,
      "scope": "affected-files",
      "scopeDescription": "formattable files",
      "impact": [
        "src/**/*.ts",
        "features/**/*.ts",
        "test/**/*.ts",
        "scripts/**/*.mjs",
        "*.mjs",
        "*.json",
        "*.md",
        "*.toml",
        "*.yml",
        "docs/**/*.md",
        ".github/**/*.yml"
      ]
    },
    {
      "gate": "Lint",
      "target": "lint",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 15,
      "scope": "affected-files",
      "scopeDescription": "lintable files",
      "scopeExclude": ["dist/**", "reports/**", "coverage/**", ".stryker-tmp/**"],
      "impact": ["**/*.ts", "**/*.mjs", "**/*.cjs"]
    },
    {
      "gate": "Types",
      "target": "types",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 20,
      "scope": "whole",
      "impact": ["**/*.ts", "**/*.mjs", "tsconfig*.json", "package.json"]
    },
    {
      "gate": "Unit tests",
      "target": "unit",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 10,
      "scope": "affected-files",
      "scopeDescription": "unit test files",
      "scopeMatch": ["src/**/*.test.ts"],
      "scopeExclude": ["src/**/*.integration.test.ts"],
      "impact": ["src/**/*.ts"]
    },
    {
      "gate": "Integration tests",
      "target": "integration",
      "tier": "full",
      "cadence": "change",
      "costSeconds": 180,
      "scope": "affected-files",
      "scopeDescription": "integration test files",
      "scopeMatch": ["src/**/*.integration.test.ts"],
      "impact": ["src/**/*.ts", "test/**/*.ts"]
    },
    {
      "gate": "E2E tests",
      "target": "e2e",
      "tier": "full",
      "cadence": "change",
      "costSeconds": 60,
      "scope": "whole",
      "impact": ["src/**/*.ts", "features/**", "test/**/*.ts"]
    },
    {
      "gate": "Context boundaries",
      "target": "boundaries",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 15,
      "scope": "whole",
      "impact": ["src/**/*.ts", "scripts/check-boundaries.mjs"]
    },
    {
      "gate": "Dependency rule",
      "target": "dependency-rule",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 10,
      "scope": "whole",
      "impact": ["src/**/*.ts", "scripts/check-dependency-rule.mjs"]
    },
    {
      "gate": "Static metrics",
      "target": "metrics",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 20,
      "scope": "whole",
      "impact": ["src/**", "features/**", "test/**", "scripts/**"]
    },
    {
      "gate": "Dependency vulnerabilities",
      "target": "vulnerabilities",
      "tier": "full",
      "cadence": "change",
      "costSeconds": 30,
      "scope": "whole",
      "impact": ["package.json", "package-lock.json"]
    },
    {
      "gate": "Secrets",
      "target": "secrets",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 10,
      "scope": "whole",
      "impact": ["**/*"]
    },
    {
      "gate": "Avoided terms",
      "target": "avoided-terms",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 5,
      "scope": "whole",
      "impact": ["**/*.ts", "**/*.md", "scripts/**/*.mjs"]
    },
    {
      "gate": "Guide pointers",
      "target": "guide-pointers",
      "tier": "fast",
      "cadence": "change",
      "costSeconds": 5,
      "scope": "whole",
      "impact": ["**/*.md", "src/**", "scripts/**", "test/**", "features/**"]
    },
    {
      "gate": "Mutation",
      "name": "Mutation (changed code)",
      "target": "mutation",
      "tier": "full",
      "cadence": "change",
      "costSeconds": 120,
      "scope": "changed",
      "scopeRecord": "mutation",
      "impact": ["src/**/domain/**/*.ts"]
    },
    {
      "gate": "Mutation",
      "name": "Mutation (whole codebase)",
      "target": "mutation-full",
      "tier": "full",
      "cadence": "periodic",
      "costSeconds": 900,
      "scopeRecord": "mutation",
      "schedule": "0 3 * * 1 (Monday 03:00 UTC), or on demand",
      "protection": "The reduced-scope Mutation check still mutates the changed domain files on every change.",
      "residualRisk": "Domain code outside the changed set is not mutated between integral runs, so a surviving mutant there stays undetected until the next run.",
      "impact": ["src/**/domain/**/*.ts"]
    }
  ]
}
